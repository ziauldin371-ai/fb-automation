# Facebook Graph API Configuration
# Get your Page Access Token and Page ID from https://developers.facebook.com/
FB_PAGE_ID=your_facebook_page_id
FB_PAGE_ACCESS_TOKEN=your_permanent_or_long_lived_page_access_token

# AI Generation Engine (Choose Gemini, OpenAI, or both)
# Google Gemini API key: Get from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key

# Optional: OpenAI API Key (fallback or alternative)
OPENAI_API_KEY=

# Vercel Cron Security Secret
# Generate any secure random string to protect the /api/cron endpoint
CRON_SECRET=super_secret_cron_token_12345

# Storage / Database (Optional for Vercel, defaults to persistent memory/JSON storage)
# For production PostgreSQL / Supabase:
# DATABASE_URL=postgresql://user:pass@host:5432/db
# Or Upstash Redis:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# App Base URL (e.g. https://your-app.vercel.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
